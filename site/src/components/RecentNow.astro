---
// site/src/components/RecentNow.astro - interests block for homepage grid
const updated = '2026-07-03';
const interests = [
  'Distributed systems and their messes',
  'Teaching a bot to trade',
  'How brains learn',
  'Why we believe what we believe',
  'Personality and the wiring behind human behaviour',
];
---
<section class="posts bg-surface-soft rounded-lg p-6 h-full">
  <h2 class="text-[1.05rem] font-semibold mb-5">Interests</h2>
  <div class="text-[14px] font-mono text-muted opacity-60 tracking-wide">
    <span>Updated {updated}</span>
  </div>
  <ul class="mt-3 space-y-1.5 text-[17px] leading-snug list-disc pl-4">
    {interests.map((i) => <li>{i}</li>)}
  </ul>
</section>
